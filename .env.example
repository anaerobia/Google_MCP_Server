# Copy to .env and fill in. .env is gitignored; never commit real values.
# From Google Cloud console → APIs & Services → Credentials → OAuth client ID
# of type "Desktop app".
GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-client-secret

# Optional. Defaults to ~/.config/gcal-mcp/token.json (created mode 0600).
# GCAL_MCP_TOKEN_PATH=/absolute/path/to/token.json
